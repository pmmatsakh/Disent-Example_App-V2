{
  "project": "my-container",
  "domain": "example.com",
  "scheme": "https",
  "note": "Edit this file to add or update apps. index.html renders whatever is here — no code changes needed. Routing is BY PORT: the subdomain is computed as {project}-{port}.{domain} (e.g. my-container-8978.example.com). The app NAME never appears in the hostname. Static apps (port null) are served by nginx on :80. Apps MUST bind 0.0.0.0 — a 127.0.0.1 listener gives a 502.",
  "apps": [
    {
      "name": "docs",
      "label": "Documentation",
      "category": "docs",
      "language": "markdown",
      "mode": "static",
      "status": "live",
      "port": 8081,
      "description": "How to run and deploy every live example, plus the platform rules (routing, binding, uv, Node 22, secrets)."
    },
    {
      "name": "nodejs",
      "label": "nodejs",
      "category": "environments",
      "language": "javascript",
      "mode": "proxy",
